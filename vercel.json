{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/test-simple",
      "destination": "/api/test"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/recommend/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/shop/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/review_json(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/search_shops_json(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/upload-image(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/articles/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/recommended(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/static/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/src/uploads/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
