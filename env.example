# -------------------------------
# Neon / Postgres configuration
# -------------------------------
# 推荐：直接使用 Neon 提供的连接字符串（Node `server.js` + Python `db.py` 都会优先读取）
# Neon 控制台里复制的连接串一般长这样：
# postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/DBNAME?sslmode=require
NEON_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/DBNAME?sslmode=require

# 兼容写法：如果你的部署平台只给 `DATABASE_URL`，也可以用这个变量名
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/DBNAME?sslmode=require

# 备选：不用连接字符串时，使用分拆的连接参数（本地 Postgres / 其它托管都可）
# DB_HOST=localhost
# DB_NAME=india_reviews
# DB_USER=user
# DB_PASSWORD=
# DB_PORT=5432

# -------------------------------
# Frontend configuration (optional)
# -------------------------------
# 前端调用 Node API 的地址；默认是 http://localhost:3001
# VITE_API_BASE_URL=http://localhost:3001















